   "body": "{\"pagination\":{\"limit\":100,\"offset\":0,\"count\":1,\"total\":1},\"data\":[{\"open\":101.0,\"high\":102.0,\"low\":100.0,\"close\":101.5,\"volume\":1000.0,\"adj_close\":101.5,\"name\":\"Apple Inc\",\"exchange_code\":\"NASDAQ\",\"asset_type\":\"Stock\",\"price_currency\":\"USD\",\"symbol\":\"AAPL\",\"exchange\":\"XNAS\",\"date\":\"2026-11-02T00:00:00+0000\"}]}",
   "expect": {
    "price": 101.5,
    "currency": "USD",
    "tradingDate": "2026-11-02",
    "priceType": "eod_close",
    "currencyEvidence": "provider_quote"
   }
  },
  {
