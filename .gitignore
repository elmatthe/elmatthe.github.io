# macOS & Jekyll build output
.DS_Store
_site/
.sass-cache/
.jekyll-cache/

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Stock Data Dashboard Tool — generated test/run artifacts (never commit)
projects/Stock-Data-Dashboard-Tool/.run-temp/
projects/Stock-Data-Dashboard-Tool/files/cache/
projects/Stock-Data-Dashboard-Tool/files/exports/*
!projects/Stock-Data-Dashboard-Tool/files/exports/.gitkeep
projects/Stock-Data-Dashboard-Tool/files/plots/*
!projects/Stock-Data-Dashboard-Tool/files/plots/.gitkeep
projects/Stock-Data-Dashboard-Tool/files/website-assets/*
!projects/Stock-Data-Dashboard-Tool/files/website-assets/.gitkeep

# Secrets — never commit personal FRED API keys (created/kept locally only)
projects/CPI_Automation/files/config.json
projects/CPI_Automation/files/fred_api_key.md

# Desktop tools on /projects/ — launcher/bootstrap runtime output (never commit)
projects/*/files/temp/
projects/*/files/test-logs/
projects/*/files/runtime/
projects/*/files/run-temp/
# CPI Web Scraper — the launcher creates the private config (FRED key) at the tool root
projects/CPI-Webscraper/config.toml
projects/CPI-Webscraper/files/config.json
